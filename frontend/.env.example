# Optional. Leave unset for local development - the app then calls port 5000
# on the same host the page was opened from, which works from this computer
# and from other devices on the same network.
#
# Set it when the API is hosted elsewhere:
# VITE_API_URL=https://smartlab-api.example.com/api

# Only set this on the kiosk device. It is the key the self-service kiosk
# uses to reach the API, and it must match KIOSK_API_KEY (or AGENT_API_KEY)
# on the server. Leave it unset on ordinary machines.
# VITE_KIOSK_KEY=
