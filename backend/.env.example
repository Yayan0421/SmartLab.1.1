# ---------------------------------------------------------------------
# SMARTLAB backend environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Where the React app runs. Comma-separated list for multiple origins.
CORS_ORIGIN=http://localhost:5173

# Supabase project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key: server-side ONLY, bypasses RLS. Never expose to React.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Shared secret the monitoring agent on each PC sends as x-agent-key
AGENT_API_KEY=replace-me-with-an-agent-key

# A computer with no heartbeat for this many seconds is treated as OFFLINE
OFFLINE_AFTER_SECONDS=120

# Code required by the administrator signup portal (/admin/register).
# Leave blank to disable admin self-registration entirely.
ADMIN_SIGNUP_CODE=change-me

# Key used by the self-service kiosk. Leave blank to reuse AGENT_API_KEY.
# Only ever put this on the kiosk device itself.
KIOSK_API_KEY=

# The laboratory's timezone, as an IANA name. Bookings, opening hours and
# "today" are local facts, so they are computed here rather than in UTC.
LAB_TIMEZONE=Asia/Manila

# A network receipt printer (Wi-Fi or Ethernet), addressed directly.
#
# Set PRINTER_HOST and the server prints every check-in itself, over TCP
# 9100, whatever device did the scanning - no print app, no browser flag,
# and a failure that is logged rather than silent. Leave it blank and the
# kiosk keeps printing through the browser as before.
#
# Give the printer a fixed address, or a DHCP reservation on the router:
# one that moves after a reboot is a kiosk that quietly stops printing.
#
# PRINTER_WIDTH is characters per line, not millimetres - 32 for a 58mm
# roll, 48 for an 80mm one.
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_WIDTH=32
